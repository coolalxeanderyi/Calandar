rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 你自己的資料：只有登入的本人能讀寫
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 生日表單（朋友頁 →「生日表單」）：朋友不用登入就能填
    // forms/{表單編號}：表單的標題和說明。知道網址的人才找得到；只有建立的人能改、能刪
    match /forms/{formId} {
      allow get: if true;
      allow list: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && validForm(request.resource.data);
      allow update: if signedIn()
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && validForm(request.resource.data);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // 朋友填的回覆：誰都可以「新增」（表單要是開放的），只有表單的主人能看、能刪，誰都不能改
      match /responses/{responseId} {
        allow create: if formIsOpen(formId) && validResponse(request.resource.data);
        allow read, delete: if signedIn() && ownsForm(formId);
      }
    }

    function signedIn() {
      return request.auth != null;
    }

    function formPath(formId) {
      return /databases/$(database)/documents/forms/$(formId);
    }

    function formIsOpen(formId) {
      return exists(formPath(formId)) && get(formPath(formId)).data.open == true;
    }

    function ownsForm(formId) {
      return exists(formPath(formId)) && get(formPath(formId)).data.owner == request.auth.uid;
    }

    function validForm(d) {
      return d.keys().hasOnly(['owner', 'title', 'intro', 'from', 'open', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() <= 100
        && d.intro is string && d.intro.size() <= 1000
        && d.from is string && d.from.size() <= 100
        && d.open is bool;
    }

    function shortText(d, key) {
      return !(key in d) || (d[key] is string && d[key].size() <= 1000);
    }

    // 名字必填；生日是「2001-03-14」或不知道年份的「--03-14」；其他欄位可以不填
    function validResponse(d) {
      return d.keys().hasOnly(['name', 'birthday', 'likes', 'dislikes', 'note', 'createdAt'])
        && d.keys().hasAll(['name', 'birthday', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.birthday is string
        && d.birthday.matches('((19|20)[0-9]{2}|-)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
        && shortText(d, 'likes') && shortText(d, 'dislikes') && shortText(d, 'note')
        && d.createdAt == request.time;
    }
  }
}
